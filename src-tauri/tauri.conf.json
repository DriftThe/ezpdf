{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ezpdf",
  "version": "0.1.0",
  "identifier": "com.drift.ezpdf",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && node scripts/pack-runtime.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ezpdf",
        "width": 1600,
        "height": 950,
        "minWidth": 1000,
        "minHeight": 660,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "DriftThe",
    "category": "Productivity",
    "shortDescription": "实时 PDF 翻译阅读器",
    "longDescription": "本地 OCR + LLM 逐页翻译的 PDF 阅读器：原文/译文双栏，边读边翻。",
    "resources": {
      "resources/python": "python",
      "resources/pyserver": "pyserver",
      "resources/system_prompt": "system_prompt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    },
    "linux": {
      "deb": {
        "depends": ["xdg-utils"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
